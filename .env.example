# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/haece?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Public site URL (used for Stripe redirects). Set to your live domain.
NEXT_PUBLIC_BASE_URL=https://your-site.netlify.app
# Optional explicit override; Netlify also provides URL automatically.
SITE_URL=https://your-site.netlify.app

# Admin panel
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=any-long-random-string

# Reservation sweeper cron
CRON_SECRET=any-long-random-string
